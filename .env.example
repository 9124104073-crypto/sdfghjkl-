# ---------------------------------------------------------------------------
# NIRMAN AI environment. Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database. SQLite keeps the project runnable with zero infrastructure.
# docker-compose overrides this with the PostGIS service.
DATABASE_URL=sqlite:///./backend/nirman.db
# DATABASE_URL=postgresql+psycopg://nirman:nirman@db:5432/nirman
# Supabase production database (copy the session/direct connection from its Connect dialog).
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-in-production
ENVIRONMENT=development

# Supabase Auth + private Storage. Keep the service role key on the backend only.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=nirman-files
# SUPABASE_REDIRECT_URL=https://your-domain.com/login

# Demo posture. DEMO_MODE keeps seeded Chennai data, simulated IoT and the
# MockAIProvider working when no LLM is configured.
DEMO_MODE=true
AUTO_SEED=true

# Copilot provider: mock | local | hosted
AI_PROVIDER=mock
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# IoT
# MQTT_BROKER_URL=mqtt://localhost:1883

# Frontend build-time API origin (leave empty to use the Vite dev proxy)
VITE_API_BASE_URL=
